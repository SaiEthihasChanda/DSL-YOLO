# Flask API Configuration
# Set FLASK_URL to your publicly accessible Flask server URL
# For local development, omit this (defaults to http://127.0.0.1:5000)
# For Streamlit Cloud or remote deployments, set to your public Flask URL

# Example for ngrok tunnel:
# FLASK_URL=https://your-ngrok-url.ngrok.io

# Example for deployed server:
# FLASK_URL=https://your-api-domain.com

FLASK_URL=http://127.0.0.1:5000
